# Supabase (production) connection — create the database yourself, then fill
# these in. For LOCAL development against the Postgres container, use
# .env.docker.example instead: cp .env.docker.example .env

DB_HOST=db.xxxxxxxxxxxx.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=

# API server port (optional, defaults to 3000)
PORT=3000

# TLS mode: 'require' (default) or 'disable'.
# Leave this unset for Supabase. It defaults to 'require' precisely so that
# forgetting it cannot silently drop TLS in production. 'disable' exists only
# for the local Postgres container, which does not speak TLS.
# DB_SSL=require

# Optional: path to Supabase's CA certificate. When set, TLS certificate
# verification is enabled. When unset, the connection is encrypted but the
# server's identity is not verified.
# DB_SSL_CA=./certs/supabase-ca.crt
