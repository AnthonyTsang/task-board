# Local development against the Postgres container in docker-compose.yml.
# Copy to .env to use it:  cp .env.docker.example .env
#
# Keep your Supabase values in .env.example (or somewhere safe) and swap .env
# when you want to point at production.

DB_HOST=localhost
DB_PORT=54322
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=postgres

# The container does not speak TLS, so it must be disabled here.
# NEVER set this against a hosted database — omitting it defaults to `require`,
# which is what production wants.
DB_SSL=disable

PORT=3000
